save-exact=true
ignore-scripts=true
min-release-age=5
# TODO: remove after 2026-04-19 when follow-redirects 1.16.0 matures past min-release-age (auth header leak on cross-domain redirects)
minimum-release-age-exclude[]=follow-redirects
# TODO: remove after 2026-05-11 when hono 4.12.18 matures past min-release-age (CSS injection, JWT NumericDate, Vary cache leakage CVEs)
minimum-release-age-exclude[]=hono
# TODO: remove after 2026-05-10 when fast-uri 3.1.2 matures past min-release-age (host confusion + path traversal CVEs)
minimum-release-age-exclude[]=fast-uri